# Copie para .env NA RAIZ do projeto no servidor e troque os valores.
# O app lê este .env automaticamente (pydantic-settings). NÃO versionar o .env real.

APP_NAME="Fintech Guard API"

# Em produção isto desliga /docs e /openapi.json (não vaza o mapa da API).
ENVIRONMENT=production

# Gere UMA vez no servidor:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=TROQUE_POR_UM_SEGREDO_FORTE_DE_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# SQLite em disco (persiste no VPS). Caminho absoluto, em pasta PRIVADA (fora do htdocs).
DATABASE_URL=sqlite:////home/<USUARIO-DO-SITE>/fintech-api/fintech_guard.db
# Alternativa MySQL do CloudPanel (requer driver pymysql no requirements):
# DATABASE_URL=mysql+pymysql://usuario:senha@127.0.0.1:3306/fintech

# Origens do front que vão consumir a API (sem curinga, sem caminho).
CORS_ORIGINS=https://<SEU-DOMINIO>

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Limite por usuário na inferência /classify (defesa de CPU).
CLASSIFY_MAX_REQUESTS=60
CLASSIFY_WINDOW_SECONDS=60

# Contas sintéticas criadas pelo seed. Troque as senhas.
SEED_USERNAME=analista
SEED_PASSWORD=TROQUE_ESTA_SENHA_1
SEED_ADMIN_USERNAME=supervisor
SEED_ADMIN_PASSWORD=TROQUE_ESTA_SENHA_2
