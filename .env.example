# Copie para .env e troque os valores. O .env não vai pro git.

APP_NAME="Fintech Guard API"
ENVIRONMENT=development

# gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-antes-de-rodar
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

DATABASE_URL=sqlite:///./fintech_guard.db

# allowlist CORS: origens exatas, sem * ou caminhos, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5 tentativas totais por IP em janela deslizante de 300s; 1 worker
# sexta tentativa: HTTP 429 + Retry-After; detalhes em docs/security-controls.md
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# usuário criado pelo scripts/seed.py
SEED_USERNAME=analista
SEED_PASSWORD=Troque@Esta#Senha123
